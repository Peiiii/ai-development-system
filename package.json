{
  "name": "@nextclaw/qingtian",
  "type": "module",
  "scripts": {
    "check": "node checks/validate-payload.mjs",
    "test": "node --test tests/*.test.mjs",
    "bench:remote": "node benchmarks/run-remote.mjs",
    "lab:open": "node benchmarks/open-dashboard.mjs",
    "build:site": "node scripts/build-site.mjs",
    "deploy:site": "npm run check && npm test && npm run build:site && wrangler deploy",
    "dashboard": "node bin/qingtian.mjs dashboard",
    "dev": "node bin/qingtian.mjs dashboard --watch",
    "test:browser": "node tests/dashboard-browser.mjs && node tests/dashboard-theme.mjs && node tests/dashboard-components.mjs && node tests/dashboard-preview.mjs && node tests/dashboard-skills.mjs",
    "test:package": "node tests/package-smoke.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "version": "0.1.8",
  "description": "擎天：可安装的 AI 驱动开发体系与跨项目产物大盘",
  "bin": {
    "qingtian": "bin/qingtian.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "bin/",
    "lib/",
    "dashboard/",
    "payload/",
    "checks/",
    "manifest.json",
    "README.md"
  ],
  "homepage": "https://ai-dev.nextclaw.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Peiiii/ai-development-system.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "marked": "18.1.0",
    "sanitize-html": "2.18.0"
  }
}
